# Copy to .env.local for the relay deploy step. Never commit .env.local.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
RELAY_SECRET=

# Client-side defaults (the relay URL is public and may be committed in apps/*/.env)
RELAY_URL=
# LOCAL_ONLY=1 keeps every client fully offline; no network calls are made.
LOCAL_ONLY=0
